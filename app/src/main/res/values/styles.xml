<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#AFC8FF</item>
        <item name="android:windowBackground">#090F1A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="PrayerText">
        <item name="android:fontFamily">@font/noto_naskh_arabic</item>
        <item name="android:textColor">#F0F3FF</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="SettingsButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#B8CBF8</item>
    </style>
</resources>
