<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri"
            android:gravity="start"
            android:text="@string/app_name"
            android:textColor="#F0F3FF"
            android:textSize="34sp" />

        <FrameLayout
            android:id="@+id/widget_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/switch_preview"
            style="@style/SettingsButton"
            android:text="@string/preview_compact" />

        <Button
            android:id="@+id/add_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/primary_button"
            android:text="@string/add_widget"
            android:textAllCaps="false"
            android:textColor="#142341"
            android:textSize="16sp" />

        <Button
            android:id="@+id/countdown_settings"
            style="@style/SettingsButton"
            android:layout_marginTop="8dp"
            android:text="@string/countdown_settings" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/control"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/city"
                android:textColor="#BDD0ED"
                android:textSize="13sp" />

            <Button
                android:id="@+id/choose_city"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="0dp"
                android:textAllCaps="false"
                android:textColor="#F0F3FF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calculation_method"
                android:textColor="#A6B7D3"
                android:textSize="13sp" />

            <Button
                android:id="@+id/calendar_adjustments"
                style="@style/SettingsButton"
                android:text="@string/calendar_adjustments" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/control"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_permissions"
                android:textColor="#F0F3FF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/exact_update_label"
                android:textColor="#F0F3FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/exact_update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#BDD0ED"
                android:textSize="13sp" />

            <Button
                android:id="@+id/open_exact_update_settings"
                style="@style/SettingsButton"
                android:text="@string/open_exact_update_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/battery_label"
                android:textColor="#F0F3FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/battery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#BDD0ED"
                android:textSize="13sp" />

            <Button
                android:id="@+id/open_battery_settings"
                style="@style/SettingsButton"
                android:text="@string/open_battery_settings" />

            <Button
                android:id="@+id/refresh_widgets"
                style="@style/SettingsButton"
                android:text="@string/refresh_widgets" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
